<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <TextView
        android:id="@+id/tv_input_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Input"
        android:textSize="24sp"
        android:textColor="#888888"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/tv_display"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="0.0"
        android:textSize="30sp"
        android:gravity="end|center_vertical"
        android:background="#DCDCDC"
        android:paddingEnd="12dp"
        app:layout_constraintTop_toBottomOf="@id/tv_input_hint"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!--第一行7 8 9 ÷-->
    <Button android:id="@+id/b7"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:text="7"
        app:layout_constraintTop_toBottomOf="@id/tv_display"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/b8"
        app:layout_constraintWidth_percent="0.25"/>

    <Button android:id="@+id/b8"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:text="8"
        app:layout_constraintTop_toBottomOf="@id/tv_display"
        app:layout_constraintStart_toEndOf="@id/b7"
        app:layout_constraintEnd_toStartOf="@id/b9"
        app:layout_constraintWidth_percent="0.25"/>

    <Button android:id="@+id/b9"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:text="9"
        app:layout_constraintTop_toBottomOf="@id/tv_display"
        app:layout_constraintStart_toEndOf="@id/b8"
        app:layout_constraintEnd_toStartOf="@id/b_div"
        app:layout_constraintWidth_percent="0.25"/>

    <Button android:id="@+id/b_div"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:text="÷"
        app:layout_constraintTop_toBottomOf="@id/tv_display"
        app:layout_constraintStart_toEndOf="@id/b9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.25"/>

    <!--第二行4 5 6 ×-->
    <Button android:id="@+id/b4"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:text="4"
        app:layout_constraintTop_toBottomOf="@id/b7"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/b5"
        app:layout_constraintWidth_percent="0.25"/>

    <Button android:id="@+id/b5"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:text="5"
        app:layout_constraintTop_toBottomOf="@id/b8"
        app:layout_constraintStart_toEndOf="@id/b4"
        app:layout_constraintEnd_toStartOf="@id/b6"
        app:layout_constraintWidth_percent="0.25"/>

    <Button android:id="@+id/b6"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:text="6"
        app:layout_constraintTop_toBottomOf="@id/b9"
        app:layout_constraintStart_toEndOf="@id/b5"
        app:layout_constraintEnd_toStartOf="@id/b_mul"
        app:layout_constraintWidth_percent="0.25"/>

    <Button android:id="@+id/b_mul"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:text="×"
        app:layout_constraintTop_toBottomOf="@id/b_div"
        app:layout_constraintStart_toEndOf="@id/b6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.25"/>

    <!--第三行1 2 3 +-->
    <Button android:id="@+id/b1"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:text="1"
        app:layout_constraintTop_toBottomOf="@id/b4"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/b2"
        app:layout_constraintWidth_percent="0.25"/>

    <Button android:id="@+id/b2"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:text="2"
        app:layout_constraintTop_toBottomOf="@id/b5"
        app:layout_constraintStart_toEndOf="@id/b1"
        app:layout_constraintEnd_toStartOf="@id/b3"
        app:layout_constraintWidth_percent="0.25"/>

    <Button android:id="@+id/b3"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:text="3"
        app:layout_constraintTop_toBottomOf="@id/b6"
        app:layout_constraintStart_toEndOf="@id/b2"
        app:layout_constraintEnd_toStartOf="@id/b_plus"
        app:layout_constraintWidth_percent="0.25"/>

    <Button android:id="@+id/b_plus"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:text="+"
        app:layout_constraintTop_toBottomOf="@id/b_mul"
        app:layout_constraintStart_toEndOf="@id/b3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.25"/>

    <!--第四行 . 0 = − -->
    <Button android:id="@+id/b_dot"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:text="."
        app:layout_constraintTop_toBottomOf="@id/b1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/b0"
        app:layout_constraintWidth_percent="0.25"/>

    <Button android:id="@+id/b0"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:text="0"
        app:layout_constraintTop_toBottomOf="@id/b2"
        app:layout_constraintStart_toEndOf="@id/b_dot"
        app:layout_constraintEnd_toStartOf="@id/b_eq"
        app:layout_constraintWidth_percent="0.25"/>

    <Button android:id="@+id/b_eq"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:text="="
        app:layout_constraintTop_toBottomOf="@id/b3"
        app:layout_constraintStart_toEndOf="@id/b0"
        app:layout_constraintEnd_toStartOf="@id/b_minus"
        app:layout_constraintWidth_percent="0.25"/>

    <Button android:id="@+id/b_minus"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:text="−"
        app:layout_constraintTop_toBottomOf="@id/b_plus"
        app:layout_constraintStart_toEndOf="@id/b_eq"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.25"/>

</androidx.constraintlayout.widget.ConstraintLayout>