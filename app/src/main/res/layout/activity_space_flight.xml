<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- 顶部3个Tab -->
    <LinearLayout
        android:id="@+id/ll_tab1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/ll_tab2"
        app:layout_constraintHorizontal_weight="1">
        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/space_station_icon"
            android:scaleType="fitCenter"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Space Stations"
            android:textSize="11sp"
            android:textColor="#444444"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_tab2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/ll_tab1"
        app:layout_constraintEnd_toStartOf="@id/ll_tab3"
        app:layout_constraintHorizontal_weight="1">
        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/rocket_icon"
            android:scaleType="fitCenter"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Flights"
            android:textSize="11sp"
            android:textColor="#444444"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_tab3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/ll_tab2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1">
        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/rover_icon"
            android:scaleType="fitCenter"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rovers"
            android:textSize="11sp"
            android:textColor="#444444"/>
    </LinearLayout>

    <!-- 左侧绿色 DCA -->
    <TextView
        android:id="@+id/tv_dca"
        android:layout_width="0dp"
        android:layout_height="90dp"
        android:text="DCA"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:background="#237a3b"
        android:gravity="center"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/ll_tab1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/arrow_container"
        app:layout_constraintHorizontal_weight="1"/>

    <!-- 右侧绿色 MARS -->
    <TextView
        android:id="@+id/tv_mars"
        android:layout_width="0dp"
        android:layout_height="90dp"
        android:text="MARS"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:background="#237a3b"
        android:gravity="center"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/ll_tab1"
        app:layout_constraintStart_toEndOf="@id/arrow_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"/>

    <!-- 中间悬浮白色方块双向箭头 -->
    <LinearLayout
        android:id="@+id/arrow_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#ffffff"
        android:padding="12dp"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="@id/tv_dca"
        app:layout_constraintBottom_toBottomOf="@id/tv_dca"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <ImageView
            android:id="@+id/iv_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/double_arrows"
            android:scaleType="fitCenter"/>
    </LinearLayout>

    <!-- One Way 橙色栏 -->
    <LinearLayout
        android:id="@+id/ll_oneway"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#ff8822"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tv_dca"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="One Way"
            android:textColor="#FFFFFF"
            android:textSize="14sp"/>
        <Switch
            android:id="@+id/switch_oneway"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

    <!-- 1 Traveller -->
    <TextView
        android:id="@+id/tv_traveller"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1 Traveller"
        android:textColor="#FFFFFF"
        android:background="#ff8822"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:textSize="14sp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/ll_oneway"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- ======================【重点修改区域】====================== -->
    <!-- 用LinearLayout包裹火箭+星球，整个容器水平居中！！ -->
    <LinearLayout
        android:id="@+id/ll_space_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="50dp"
        app:layout_constraintTop_toBottomOf="@id/tv_traveller"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/iv_rocket_small"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/rocket_icon"
            android:scaleType="fitCenter"/>

        <ImageView
            android:id="@+id/iv_galaxy"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/galaxy"
            android:scaleType="fitCenter"/>
    </LinearLayout>
    <!-- ========================================================== -->

    <!-- 底部DEPART紫色按钮 -->
    <Button
        android:id="@+id/btn_depart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="DEPART"
        android:textColor="#FFFFFF"
        android:background="#553388"
        android:paddingVertical="14dp"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>