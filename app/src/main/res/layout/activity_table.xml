<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <!-- 标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#cccccc"
        android:gravity="center_vertical"
        android:padding="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hello TableLayout"
            android:textSize="16sp"
            android:textColor="#000000"/>
    </LinearLayout>

    <!-- 表格内容 -->
    <TableLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stretchColumns="0"
        android:background="#000000">

        <!-- 第1行 -->
        <TableRow
            android:background="#000000">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Open..."
                android:textColor="#ffffff"
                android:padding="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ctrl-O"
                android:textColor="#ffffff"
                android:padding="8dp"
                android:gravity="right"/>
        </TableRow>

        <!-- 第2行 -->
        <TableRow
            android:background="#000000">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Save..."
                android:textColor="#ffffff"
                android:padding="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ctrl-S"
                android:textColor="#ffffff"
                android:padding="8dp"
                android:gravity="right"/>
        </TableRow>

        <!-- 第3行 -->
        <TableRow
            android:background="#000000">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Save As..."
                android:textColor="#ffffff"
                android:padding="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ctrl-Shift-S"
                android:textColor="#ffffff"
                android:padding="8dp"
                android:gravity="right"/>
        </TableRow>

        <!-- 分割线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#ffffff"/>

        <!-- 第4行 -->
        <TableRow
            android:background="#000000">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Import..."
                android:textColor="#ffffff"
                android:padding="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ctrl-I"
                android:textColor="#ffffff"
                android:padding="8dp"
                android:gravity="right"/>
        </TableRow>

        <!-- 第5行 -->
        <TableRow
            android:background="#000000">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Export..."
                android:textColor="#ffffff"
                android:padding="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ctrl-E"
                android:textColor="#ffffff"
                android:padding="8dp"
                android:gravity="right"/>
        </TableRow>

        <!-- 分割线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#ffffff"/>

        <!-- 第6行 -->
        <TableRow
            android:background="#000000">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Quit"
                android:textColor="#ffffff"
                android:padding="8dp"/>
        </TableRow>

    </TableLayout>

</LinearLayout>